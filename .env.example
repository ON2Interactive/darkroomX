# Copy this file to .env and set your secrets.
GOOGLE_API_KEY=""
# Optional override. Default model if unset: gemini-2.5-flash-image-preview
GOOGLE_IMAGE_EDIT_MODEL="gemini-2.5-flash-image-preview"
# Optional endpoint override.
# GOOGLE_IMAGE_EDIT_ENDPOINT="https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-image-preview:generateContent?key=YOUR_KEY"

# Peecho Print API
PEECHO_API_KEY=""
PEECHO_API_SECRET=""
# Optional. Default: https://test.www.peecho.com
PEECHO_BASE_URL="https://test.www.peecho.com"
# Framed prints only: list the offerings you want exposed in the UI.
# Example:
# PEECHO_FRAMED_OFFERINGS_JSON=[{"key":"frame_30x40_black","label":"Framed 30x40 Black","offeringId":"1234"},{"key":"frame_30x40_white","label":"Framed 30x40 White","offeringId":"5678"}]
PEECHO_FRAMED_OFFERINGS_JSON="[]"
# Required for Peecho to fetch uploaded print assets from your app.
# Example: https://your-domain.com
PEECHO_PUBLIC_BASE_URL=""
PUBLIC_BASE_URL=""

# Contact form email (SendGrid)
SENDGRID_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL="hello@darkroomx.com"
# Optional override for internal signup notification recipient
SIGNUP_NOTIFY_EMAIL="hello@darkroomx.com"

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Optional
RECAPTCHA_ACTION="contact_submit"
RECAPTCHA_MIN_SCORE="0.5"

# Admin (temporary until Supabase auth/roles is integrated)
ADMIN_LOGIN_EMAIL=""
ADMIN_LOGIN_PASSWORD=""
ADMIN_AUTH_SECRET=""

# Supabase Auth + data
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Full public URL for OAuth callback, e.g. https://darkroomx.com/auth/callback
SUPABASE_AUTH_REDIRECT_URL=""
# Starter credits to grant once on first signup
SUPABASE_SIGNUP_CREDITS="1000"

# Stripe billing
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUBSCRIPTION_PRICE_ID=""
STRIPE_TOPUP_PRICE_ID=""
STRIPE_TOPUP_CREDITS="100"
STRIPE_SUCCESS_URL=""
STRIPE_CANCEL_URL=""
PORT=4174
